#!/bin/bash
# SnapBack CLI - Attention manager for Claude Code
set -euo pipefail

VERSION="1.1.0"
# Resolve symlinks to get the actual script directory
SOURCE="$0"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/snapback"
CONFIG_FILE="$CONFIG_DIR/config"

# Load shared config library.  Priority: repo-adjacent, then system share path.
if [[ -f "$SCRIPT_DIR/snapback-lib.sh" ]]; then
  # shellcheck source=snapback-lib.sh
  source "$SCRIPT_DIR/snapback-lib.sh"
elif [[ -f "/usr/local/share/snapback/snapback-lib.sh" ]]; then
  source "/usr/local/share/snapback/snapback-lib.sh"
else
  echo "error: snapback-lib.sh not found" >&2
  exit 1
fi

# Align lib's config path with the CLI's.
SNAPBACK_CONFIG_FILE="$CONFIG_FILE"
CLAUDE_SETTINGS="$HOME/.claude/settings.json"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helpers
print_success() { echo -e "${GREEN}✓${NC} $1"; }
print_error() { echo -e "${RED}✗${NC} $1"; }
print_warning() { echo -e "${YELLOW}!${NC} $1"; }
print_info() { echo -e "${BLUE}→${NC} $1"; }

show_help() {
  cat <<EOF
SnapBack v${VERSION} - Attention manager for Claude Code

Usage: snapback <command>

Commands:
  install [-y]  Interactive installation and configuration
  status        Check if everything is configured correctly
  on            Enable Claude Code hooks
  off           Disable Claude Code hooks (keeps config)
  mode [MODE]   Set mode: full (sound + focus) or sound (sound only)
  volume [VAL]  Get/set notification volume (0.0 - 1.0)
  browser [NAME]  Get/set browser (e.g., "Google Chrome", Arc, Safari)
  config <sub>  Get/set config: get KEY | set KEY VAL | show [--json] | path
  app           Launch menu bar app for GUI configuration
  update        Update to latest version
  uninstall     Remove config and hooks completely
  help          Show this help message

Options:
  -y, --yes     Accept defaults without prompts (for install)

Examples:
  snapback install      # First-time setup
  snapback install -y   # Install with defaults
  snapback status       # Check configuration
  snapback off          # Temporarily disable
  snapback mode sound   # Sound only, no app switching
  snapback mode full    # Sound + app switching (default)
  snapback update       # Get latest version

More info: https://github.com/teoobarca/snapback
EOF
}

# ============================================================
# STATUS COMMAND
# ============================================================
cmd_status() {
  echo ""
  echo "SnapBack Status"
  echo "───────────────"
  echo ""

  local all_ok=true

  # Check config
  if [[ -f "$CONFIG_FILE" ]]; then
    print_success "Config exists: $CONFIG_FILE"
    source "$CONFIG_FILE"
    print_info "  Focus apps: ${FOCUS_APPS[*]}"
    print_info "  Browser: $BROWSER"
    local current_mode="${MODE:-full}"
    if [[ "$current_mode" == "sound" ]]; then
      print_info "  Mode: sound (no app switching)"
    else
      print_info "  Mode: full (sound + app switching)"
    fi
  else
    print_error "Config not found: $CONFIG_FILE"
    all_ok=false
  fi

  # Check scripts
  if [[ -x "$SCRIPT_DIR/snapback.sh" ]]; then
    print_success "snapback.sh is executable"
  else
    print_error "snapback.sh not found or not executable"
    all_ok=false
  fi

  if [[ -x "$SCRIPT_DIR/snapback-resume.sh" ]]; then
    print_success "snapback-resume.sh is executable"
  else
    print_error "snapback-resume.sh not found or not executable"
    all_ok=false
  fi

  # Check Claude settings
  if [[ -f "$CLAUDE_SETTINGS" ]]; then
    if grep -q "snapback.sh" "$CLAUDE_SETTINGS" 2>/dev/null; then
      print_success "Claude Code hooks are configured"
    else
      print_warning "Claude settings exist but hooks not found"
      all_ok=false
    fi
  else
    print_error "Claude settings not found: $CLAUDE_SETTINGS"
    all_ok=false
  fi

  # Check macOS permissions
  echo ""
  echo "Permissions"
  echo "───────────"

  # Test osascript access
  if osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' &>/dev/null; then
    print_success "System Events access granted"
  else
    print_warning "System Events access may be needed"
    print_info "  Run: snapback.sh manually to trigger permission dialog"
  fi

  # Summary
  echo ""
  if [[ "$all_ok" == true ]]; then
    print_success "All checks passed! SnapBack is ready."
  else
    print_warning "Some issues found. Run 'snapback install' to fix."
  fi
  echo ""
}

# ============================================================
# ON/OFF COMMANDS
# ============================================================
cmd_on() {
  if [[ ! -f "$CLAUDE_SETTINGS" ]]; then
    print_error "Claude settings not found. Run 'snapback install' first."
    exit 1
  fi

  if ! command -v jq &>/dev/null; then
    print_error "jq is required. Install with: brew install jq"
    exit 1
  fi

  # Check if hooks already exist
  if grep -q "snapback.sh" "$CLAUDE_SETTINGS" 2>/dev/null; then
    print_warning "Hooks are already enabled"
    exit 0
  fi

  # Add hooks (preserve existing hooks from other tools)
  local tmp=$(mktemp)
  jq --arg snapback "$SCRIPT_DIR/snapback.sh" --arg resume "$SCRIPT_DIR/snapback-resume.sh" '
    # Add to PermissionRequest (preserve others)
    .hooks.PermissionRequest = ((.hooks.PermissionRequest // []) | map(select(.hooks[0].command | contains("snapback") | not))) + [{"matcher": "*", "hooks": [{"type": "command", "command": $snapback}]}] |
    # Add to Stop (preserve others)
    .hooks.Stop = ((.hooks.Stop // []) | map(select(.hooks[0].command | contains("snapback") | not))) + [{"hooks": [{"type": "command", "command": $snapback}]}] |
    # Add to PostToolUse (preserve others)
    .hooks.PostToolUse = ((.hooks.PostToolUse // []) | map(select(.hooks[0].command | contains("snapback") | not))) + [{"matcher": "Edit|Write|Bash", "hooks": [{"type": "command", "command": $resume}]}] |
    # Add to UserPromptSubmit (preserve others)
    .hooks.UserPromptSubmit = ((.hooks.UserPromptSubmit // []) | map(select(.hooks[0].command | contains("snapback") | not))) + [{"hooks": [{"type": "command", "command": $resume}]}]
  ' "$CLAUDE_SETTINGS" > "$tmp" && mv "$tmp" "$CLAUDE_SETTINGS"

  print_success "Hooks enabled"
  print_info "Restart Claude Code to apply changes"
}

cmd_off() {
  if [[ ! -f "$CLAUDE_SETTINGS" ]]; then
    print_warning "Claude settings not found. Nothing to disable."
    exit 0
  fi

  if ! command -v jq &>/dev/null; then
    print_error "jq is required. Install with: brew install jq"
    exit 1
  fi

  # Check if hooks exist
  if ! grep -q "snapback.sh" "$CLAUDE_SETTINGS" 2>/dev/null; then
    print_warning "Hooks are already disabled"
    exit 0
  fi

  # Remove snapback hooks
  local tmp=$(mktemp)
  jq '
    .hooks.PermissionRequest = ((.hooks.PermissionRequest // []) | map(select(.hooks[0].command | contains("snapback") | not))) |
    .hooks.Stop = ((.hooks.Stop // []) | map(select(.hooks[0].command | contains("snapback") | not))) |
    .hooks.PostToolUse = ((.hooks.PostToolUse // []) | map(select(.hooks[0].command | contains("snapback") | not))) |
    .hooks.UserPromptSubmit = ((.hooks.UserPromptSubmit // []) | map(select(.hooks[0].command | contains("snapback") | not))) |
    # Clean up empty arrays
    if .hooks.PermissionRequest == [] then del(.hooks.PermissionRequest) else . end |
    if .hooks.Stop == [] then del(.hooks.Stop) else . end |
    if .hooks.PostToolUse == [] then del(.hooks.PostToolUse) else . end |
    if .hooks.UserPromptSubmit == [] then del(.hooks.UserPromptSubmit) else . end |
    if .hooks == {} then del(.hooks) else . end
  ' "$CLAUDE_SETTINGS" > "$tmp" && mv "$tmp" "$CLAUDE_SETTINGS"

  print_success "Hooks disabled"
  print_info "Restart Claude Code to apply changes"
}

# ============================================================
# MODE COMMAND
# ============================================================
cmd_mode() {
  local mode="${1:-}"

  # Ensure config exists
  if [[ ! -f "$CONFIG_FILE" ]]; then
    print_error "Config not found. Run 'snapback install' first."
    exit 1
  fi

  # If no argument, show current mode
  if [[ -z "$mode" ]]; then
    source "$CONFIG_FILE"
    local current_mode="${MODE:-full}"
    echo ""
    echo "Current mode: $current_mode"
    if [[ "$current_mode" == "sound" ]]; then
      print_info "Sound only - no app switching"
    else
      print_info "Full mode - sound + app switching"
    fi
    echo ""
    echo "Change with: snapback mode <full|sound>"
    echo ""
    exit 0
  fi

  # Validate mode
  if [[ "$mode" != "full" && "$mode" != "sound" ]]; then
    print_error "Invalid mode: $mode"
    print_info "Valid modes: full, sound"
    exit 1
  fi

  config_set MODE "$mode" --allow-new || {
    print_error "Failed to write config"
    exit 1
  }

  print_success "Mode set to: $mode"
  if [[ "$mode" == "sound" ]]; then
    print_info "Sound only - no app switching"
  else
    print_info "Full mode - sound + app switching"
  fi
}

# ============================================================
# UNINSTALL COMMAND
# ============================================================
cmd_uninstall() {
  echo ""
  echo "SnapBack Uninstall"
  echo "──────────────────"
  echo ""

  read -p "This will remove config and Claude hooks. Continue? [y/N]: " confirm
  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    echo "Cancelled."
    exit 0
  fi

  # Remove hooks first
  if [[ -f "$CLAUDE_SETTINGS" ]] && command -v jq &>/dev/null; then
    if grep -q "snapback" "$CLAUDE_SETTINGS" 2>/dev/null; then
      cmd_off
    fi
  fi

  # Remove config
  if [[ -d "$CONFIG_DIR" ]]; then
    rm -rf "$CONFIG_DIR"
    print_success "Removed config: $CONFIG_DIR"
  else
    print_info "Config not found (already removed)"
  fi

  # Remove state files
  rm -f /tmp/snapback_state 2>/dev/null || true
  rm -f "${TMPDIR:-/tmp}/snapback_last" 2>/dev/null || true
  rm -f "${TMPDIR:-/tmp}/snapback_resume_last" 2>/dev/null || true
  print_success "Removed temporary files"

  # Remove symlink from PATH
  if [[ -L "/usr/local/bin/snapback" ]]; then
    if [[ -w "/usr/local/bin" ]]; then
      rm -f "/usr/local/bin/snapback"
      print_success "Removed /usr/local/bin/snapback"
    else
      print_info "Removing /usr/local/bin/snapback (requires sudo)..."
      sudo rm -f "/usr/local/bin/snapback" 2>/dev/null && print_success "Removed /usr/local/bin/snapback" || print_warning "Could not remove /usr/local/bin/snapback"
    fi
  fi

  if [[ -L "$HOME/.local/bin/snapback" ]]; then
    rm -f "$HOME/.local/bin/snapback"
    print_success "Removed ~/.local/bin/snapback"
  fi

  # Remove installation directory (if installed globally via get.sh)
  if [[ -d "$HOME/.snapback" ]]; then
    rm -rf "$HOME/.snapback"
    print_success "Removed installation: ~/.snapback"
  fi

  echo ""
  print_success "SnapBack uninstalled"
  echo ""
}

# ============================================================
# UPDATE COMMAND
# ============================================================
cmd_update() {
  echo ""
  echo "SnapBack Update"
  echo "───────────────"
  echo ""

  local repo_url="https://github.com/teoobarca/snapback"

  # Resolve actual install directory (follow symlinks)
  local install_dir="$SCRIPT_DIR"
  if [[ -L "$0" ]]; then
    # We're running from a symlink, find the real location
    local real_path=$(readlink "$0" 2>/dev/null || true)
    if [[ -n "$real_path" ]]; then
      install_dir="$(cd "$(dirname "$real_path")" && pwd)"
    fi
  fi

  # Check if we're in a git repo
  if [[ -d "$install_dir/.git" ]]; then
    print_info "Updating via git..."
    cd "$install_dir"
    if git pull origin main 2>/dev/null; then
      print_success "Updated to latest version"
    else
      print_error "Git pull failed"
      print_info "Try: cd $install_dir && git pull"
      exit 1
    fi
  else
    print_info "Updating via tarball..."
    local tmp_dir=$(mktemp -d)
    if curl -sL "$repo_url/archive/main.tar.gz" | tar xz -C "$tmp_dir" --strip-components=1; then
      # Copy new files to install directory
      cp "$tmp_dir/snapback" "$install_dir/"
      cp "$tmp_dir/snapback.sh" "$install_dir/"
      cp "$tmp_dir/snapback-resume.sh" "$install_dir/"
      cp "$tmp_dir/install.sh" "$install_dir/"
      cp "$tmp_dir/notification.mp3" "$install_dir/" 2>/dev/null || true
      chmod +x "$install_dir/snapback" "$install_dir/snapback.sh" "$install_dir/snapback-resume.sh" "$install_dir/install.sh"
      rm -rf "$tmp_dir"
      print_success "Updated to latest version"
    else
      rm -rf "$tmp_dir"
      print_error "Download failed"
      exit 1
    fi
  fi

  echo ""
  # Show new version
  "$install_dir/snapback" --version
  echo ""
}

# ============================================================
# APP COMMAND (Menu Bar App)
# ============================================================
cmd_app() {
  local app_bundle="$SCRIPT_DIR/SnapBackApp/SnapBack.app"
  local installed_app="/Applications/SnapBack.app"

  # Check if app exists
  if [[ -d "$installed_app" ]]; then
    open "$installed_app"
  elif [[ -d "$app_bundle" ]]; then
    open "$app_bundle"
  else
    print_error "SnapBack menu bar app not found"
    print_info "Build it first: cd $SCRIPT_DIR/SnapBackApp && ./build-app.sh"
    exit 1
  fi
}

# ============================================================
# VOLUME COMMAND
# ============================================================
cmd_volume() {
  local v="${1:-}"
  if [[ -z "$v" ]]; then
    config_get VOLUME || echo "1.0"
    exit 0
  fi
  # Validate 0.0 <= v <= 1.0
  if ! [[ "$v" =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]]; then
    print_error "Invalid volume: $v (expected 0.0 - 1.0)"
    exit 2
  fi
  config_set VOLUME "$v" --allow-new
  print_success "Volume set to: $v"
}

# ============================================================
# BROWSER COMMAND
# ============================================================
cmd_browser() {
  local b="${1:-}"
  if [[ -z "$b" ]]; then
    config_get BROWSER || echo "Google Chrome"
    exit 0
  fi
  config_set BROWSER "$b"
  print_success "Browser set to: $b"
}

# ============================================================
# CONFIG COMMAND
# ============================================================
cmd_config() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    get)
      [[ $# -ge 1 ]] || { print_error "Usage: snapback config get KEY"; exit 2; }
      config_get "$1" || { print_error "Key not set: $1"; exit 1; }
      ;;
    set)
      [[ $# -ge 2 ]] || { print_error "Usage: snapback config set KEY VALUE [--allow-new]"; exit 2; }
      config_set "$@" || exit $?
      ;;
    show)
      local json=0
      [[ "${1:-}" == "--json" ]] && json=1
      if (( json )); then
        local first=1
        echo "{"
        while read -r k _; do
          local v
          if v=$(config_get "$k" 2>/dev/null); then
            (( first )) || echo ","
            first=0
            # Shell-escape for JSON: minimal (no \n in values)
            local esc="${v//\\/\\\\}"
            esc="${esc//\"/\\\"}"
            printf '  "%s": "%s"' "$k" "$esc"
          fi
        done < <(_snapback_known_keys)
        echo ""
        echo "}"
      else
        while read -r k _; do
          local v
          if v=$(config_get "$k" 2>/dev/null); then
            printf '%s=%s\n' "$k" "$v"
          fi
        done < <(_snapback_known_keys)
      fi
      ;;
    path)
      printf '%s\n' "$CONFIG_FILE"
      ;;
    "")
      print_error "Usage: snapback config <get|set|show|path> ..."
      exit 2
      ;;
    *)
      print_error "Unknown config subcommand: $sub"
      exit 2
      ;;
  esac
}

# ============================================================
# INSTALL COMMAND
# ============================================================
cmd_install() {
  # Just run the existing install script, passing through arguments
  if [[ -x "$SCRIPT_DIR/install.sh" ]]; then
    exec "$SCRIPT_DIR/install.sh" "$@"
  else
    print_error "install.sh not found in $SCRIPT_DIR"
    exit 1
  fi
}

# ============================================================
# MAIN
# ============================================================
main() {
  local cmd="${1:-help}"
  shift || true  # Remove first argument, keep the rest for passing to commands

  case "$cmd" in
    install)
      cmd_install "$@"
      ;;
    status)
      cmd_status
      ;;
    on|enable)
      cmd_on
      ;;
    off|disable)
      cmd_off
      ;;
    mode)
      cmd_mode "$@"
      ;;
    volume)
      cmd_volume "$@"
      ;;
    browser)
      cmd_browser "$@"
      ;;
    config)
      cmd_config "$@"
      ;;
    app)
      cmd_app
      ;;
    update)
      cmd_update
      ;;
    uninstall|remove)
      cmd_uninstall
      ;;
    -h|--help|help)
      show_help
      ;;
    -v|--version|version)
      echo "SnapBack v${VERSION}"
      ;;
    *)
      print_error "Unknown command: $cmd"
      echo ""
      show_help
      exit 1
      ;;
  esac
}

main "$@"
