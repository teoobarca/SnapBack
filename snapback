#!/bin/bash
# SnapBack CLI - Attention manager for Claude Code
set -euo pipefail

VERSION="1.4.0"
# Resolve symlinks to get the actual script directory
SOURCE="$0"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/snapback"
CONFIG_FILE="$CONFIG_DIR/config"

# Load shared config library.  Priority: repo-adjacent, then system share path.
if [[ -f "$SCRIPT_DIR/snapback-lib.sh" ]]; then
  # shellcheck source=snapback-lib.sh
  source "$SCRIPT_DIR/snapback-lib.sh"
elif [[ -f "/usr/local/share/snapback/snapback-lib.sh" ]]; then
  source "/usr/local/share/snapback/snapback-lib.sh"
else
  echo "error: snapback-lib.sh not found" >&2
  exit 1
fi

# Align lib's config path with the CLI's.
SNAPBACK_CONFIG_FILE="$CONFIG_FILE"

# ============================================================
# TOOL FOLDERS
# ============================================================
# Each supported AI CLI lives in its own subdirectory next to this script
# (claude/, codex/, …). Every tool folder exports the same contract:
#   detect.sh   – exit 0 if the tool is installed on this machine
#   enable.sh   – register SnapBack with that tool (idempotent)
#   disable.sh  – unregister (idempotent)
#   status.sh   – print one status line; exit 0 if enabled, 1 if not
# Adding a new tool = drop in a new folder. The CLI does not hard-code names.

# Echo names of tool folders that look complete (have detect.sh + enable.sh).
_snapback_tool_dirs() {
  local d
  for d in "$SCRIPT_DIR"/*/; do
    [[ -x "$d/detect.sh" && -x "$d/enable.sh" ]] || continue
    basename "$d"
  done
  # Always succeed: empty output is the "no tools" signal.
  return 0
}

# Echo names of tools whose detect.sh exits 0 (installed on this machine).
_snapback_detected_tools() {
  local t
  for t in $(_snapback_tool_dirs); do
    "$SCRIPT_DIR/$t/detect.sh" >/dev/null 2>&1 && echo "$t"
  done
  return 0
}

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Helpers
print_success() { echo -e "${GREEN}✓${NC} $1"; }
print_error() { echo -e "${RED}✗${NC} $1"; }
print_warning() { echo -e "${YELLOW}!${NC} $1"; }
print_info() { echo -e "${BLUE}→${NC} $1"; }

show_help() {
  cat <<EOF
SnapBack v${VERSION} - Attention manager for AI coding CLIs

Supported tools: Claude Code, Codex CLI (each in its own subdirectory; add
more by dropping a new folder with detect/enable/disable/status.sh).

Usage: snapback <command>

Commands:
  install       Auto-detect and configure (no prompts, no sudo)
  install -i    Interactive installation with prompts
  status        Check configuration and menu-bar state
  on            Enable hooks for all detected AI CLIs
  off           Disable hooks for all configured AI CLIs (keeps config)
  mode [MODE]   Get/set mode: full | sound | switch
  volume [VAL]  Get/set notification volume (0.0 - 1.0)
  browser [NAME]  Get/set browser (Google Chrome, Arc, Safari, Firefox, Brave)
  focus <sub>   list | add NAME | remove NAME | set NAME1 NAME2 ...
  config <sub>  get KEY | set KEY VAL [--allow-new] | show [--json] | path
  test          Play a notification preview
  app           Launch the menu-bar app (if installed)
  mobile <sub>  pair | unpair | status | enable | disable | logs
  update        Update to latest version (and rebuild menu-bar app if installed)
  uninstall     Remove config, hooks, and menu-bar app
  help          Show this help message

Options:
  -i, --interactive   Guided setup with prompts (for install)

Examples:
  snapback install      # Auto-setup (no prompts, no sudo)
  snapback install -i   # Interactive guided setup
  snapback status       # Check configuration
  snapback off          # Temporarily disable
  snapback mode sound   # Sound only, no app switching
  snapback mode switch  # Switch only, no sound
  snapback mode full    # Sound + app switching (default)
  snapback update       # Get latest version

More info: https://github.com/teoobarca/snapback
EOF
}

# ============================================================
# STATUS COMMAND
# ============================================================
cmd_status() {
  echo ""
  echo "SnapBack Status"
  echo "───────────────"
  echo ""

  local all_ok=true

  # Check config
  if [[ -f "$CONFIG_FILE" ]]; then
    print_success "Config exists: $CONFIG_FILE"
    source "$CONFIG_FILE"
    print_info "  Focus apps: ${FOCUS_APPS[*]:-<unset>}"
    print_info "  Browser: ${BROWSER:-<unset>}"
    local current_mode="${MODE:-full}"
    case "$current_mode" in
      sound)  print_info "  Mode: sound (no app switching)" ;;
      switch) print_info "  Mode: switch (app switching, no sound)" ;;
      *)      print_info "  Mode: full (sound + app switching)" ;;
    esac
  else
    print_error "Config not found: $CONFIG_FILE"
    all_ok=false
  fi

  # Check scripts
  if [[ -x "$SCRIPT_DIR/snapback.sh" ]]; then
    print_success "snapback.sh is executable"
  else
    print_error "snapback.sh not found or not executable"
    all_ok=false
  fi

  if [[ -x "$SCRIPT_DIR/snapback-resume.sh" ]]; then
    print_success "snapback-resume.sh is executable"
  else
    print_error "snapback-resume.sh not found or not executable"
    all_ok=false
  fi

  # Check tool integrations (one row per detected AI CLI)
  local detected
  detected="$(_snapback_detected_tools)"
  if [[ -z "$detected" ]]; then
    print_error "No supported AI CLI detected (Claude Code, Codex, …)"
    all_ok=false
  else
    local t any_enabled=false
    for t in $detected; do
      if "$SCRIPT_DIR/$t/status.sh"; then
        any_enabled=true
      fi
    done
    if [[ "$any_enabled" != true ]]; then
      print_warning "No tool integrations are enabled. Run: snapback on"
      all_ok=false
    fi
  fi

  # Check macOS permissions
  echo ""
  echo "Permissions"
  echo "───────────"

  # Test osascript access
  if osascript -e 'tell application "System Events" to get name of first application process whose frontmost is true' &>/dev/null; then
    print_success "System Events access granted"
  else
    print_warning "System Events access may be needed"
    print_info "  Run: snapback.sh manually to trigger permission dialog"
  fi

  # Menu-bar app status
  echo ""
  echo "Menu-bar app"
  echo "────────────"
  local app_path=""
  for p in "$HOME/Applications/SnapBack.app" "/Applications/SnapBack.app"; do
    if [[ -d "$p" ]]; then app_path="$p"; break; fi
  done
  if [[ -n "$app_path" ]]; then
    print_success "Installed at $app_path"
    if pgrep -x SnapBack >/dev/null 2>&1; then
      print_info "  Running"
    else
      print_info "  Not running (launch with: snapback app)"
    fi
  else
    print_info "Not installed (run 'snapback update' with Swift available to install)"
  fi

  # Effective volume (configured VOLUME × system volume)
  if [[ -f "$CONFIG_FILE" ]]; then
    local configured_vol sys_vol effective_pct
    configured_vol=$(config_get VOLUME 2>/dev/null || echo "1.0")
    sys_vol=$(osascript -e "output volume of (get volume settings)" 2>/dev/null || echo "100")
    effective_pct=$(echo "$configured_vol * $sys_vol" | bc -l 2>/dev/null | awk '{printf "%.0f", $1}')
    echo ""
    print_info "Effective volume: ${configured_vol} × ${sys_vol}% = ${effective_pct}%"
  fi

  # Summary
  echo ""
  if [[ "$all_ok" == true ]]; then
    print_success "All checks passed! SnapBack is ready."
  else
    print_warning "Some issues found. Run 'snapback install' to fix."
  fi
  echo ""
}

# ============================================================
# ON/OFF COMMANDS
# ============================================================
# Iterate every detected tool folder and run its enable.sh / disable.sh.
# Each tool script is responsible for its own conflict checks and prints
# its own one-line status. We just exit non-zero if any tool fails.
cmd_on() {
  local detected rc=0 t any=false
  detected="$(_snapback_detected_tools)"
  if [[ -z "$detected" ]]; then
    print_error "No supported AI CLI detected (Claude Code, Codex, …)"
    print_info "Install one of them, then re-run."
    exit 1
  fi
  for t in $detected; do
    any=true
    if "$SCRIPT_DIR/$t/enable.sh"; then
      :
    else
      rc=1
    fi
  done
  [[ "$any" == true ]] || { print_warning "No tool folders found"; exit 1; }
  if [[ "$rc" -eq 0 ]]; then
    print_success "Hooks enabled"
    print_info "Restart your AI CLI to apply changes"
  else
    print_warning "Some tools failed to enable (see messages above)"
    exit 1
  fi
}

cmd_off() {
  local detected rc=0 t any=false
  # `off` should also clean up tools that aren't currently detected, in case
  # the binary was uninstalled but the config files still exist.
  detected="$(_snapback_tool_dirs)"
  for t in $detected; do
    any=true
    if "$SCRIPT_DIR/$t/disable.sh"; then
      :
    else
      rc=1
    fi
  done
  [[ "$any" == true ]] || { print_warning "No tool folders found"; exit 0; }
  if [[ "$rc" -eq 0 ]]; then
    print_success "Hooks disabled"
    print_info "Restart your AI CLI to apply changes"
  else
    exit 1
  fi
}

# ============================================================
# MODE COMMAND
# ============================================================
cmd_mode() {
  local mode="${1:-}"

  # Ensure config exists
  if [[ ! -f "$CONFIG_FILE" ]]; then
    print_error "Config not found. Run 'snapback install' first."
    exit 1
  fi

  # If no argument, show current mode
  if [[ -z "$mode" ]]; then
    source "$CONFIG_FILE"
    local current_mode="${MODE:-full}"
    echo ""
    echo "Current mode: $current_mode"
    case "$current_mode" in
      sound)  print_info "Sound only - no app switching" ;;
      switch) print_info "Switch only - app switching, no sound" ;;
      *)      print_info "Full mode - sound + app switching" ;;
    esac
    echo ""
    echo "Change with: snapback mode <full|sound|switch>"
    echo ""
    exit 0
  fi

  # Validate mode
  if [[ "$mode" != "full" && "$mode" != "sound" && "$mode" != "switch" ]]; then
    print_error "Invalid mode: $mode"
    print_info "Valid modes: full, sound, switch"
    exit 1
  fi

  config_set MODE "$mode" --allow-new || {
    print_error "Failed to write config"
    exit 1
  }

  print_success "Mode set to: $mode"
  case "$mode" in
    sound)  print_info "Sound only - no app switching" ;;
    switch) print_info "Switch only - app switching, no sound" ;;
    full)   print_info "Full mode - sound + app switching" ;;
  esac
}

# ============================================================
# UNINSTALL COMMAND
# ============================================================
cmd_uninstall() {
  echo ""
  echo "SnapBack Uninstall"
  echo "──────────────────"
  echo ""

  read -p "This will remove config and AI CLI hooks. Continue? [y/N]: " confirm
  if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    echo "Cancelled."
    exit 0
  fi

  # Remove hooks/notify for every supported tool (failures are non-fatal).
  local t
  for t in $(_snapback_tool_dirs); do
    "$SCRIPT_DIR/$t/disable.sh" || true
  done

  # Remove config
  if [[ -d "$CONFIG_DIR" ]]; then
    rm -rf "$CONFIG_DIR"
    print_success "Removed config: $CONFIG_DIR"
  else
    print_info "Config not found (already removed)"
  fi

  # Remove Keychain token (1.3.0+ bridge pair token)
  if command -v security >/dev/null 2>&1; then
    security delete-generic-password -s com.snapback.mobile -a pair-token >/dev/null 2>&1 || true
    print_success "Removed Keychain entry (if present)"
  fi

  # Remove state files
  rm -f /tmp/snapback_state 2>/dev/null || true
  rm -f "${TMPDIR:-/tmp}/snapback_last" 2>/dev/null || true
  rm -f "${TMPDIR:-/tmp}/snapback_resume_last" 2>/dev/null || true
  print_success "Removed temporary files"

  # Remove symlinks from PATH
  for link in "$HOME/.local/bin/snapback" "$HOME/.local/bin/snapback-poke"; do
    if [[ -L "$link" ]]; then
      rm -f "$link"
      print_success "Removed $link"
    fi
  done

  # Legacy: clean up /usr/local/bin symlinks if present
  if [[ -L "/usr/local/bin/snapback" ]] && [[ -w "/usr/local/bin" ]]; then
    rm -f "/usr/local/bin/snapback"
    print_success "Removed /usr/local/bin/snapback"
  elif [[ -L "/usr/local/bin/snapback" ]]; then
    print_warning "Legacy symlink at /usr/local/bin/snapback — remove manually with: sudo rm /usr/local/bin/snapback"
  fi

  # Remove installation directory (if installed globally via get.sh)
  if [[ -d "$HOME/.snapback" ]]; then
    rm -rf "$HOME/.snapback"
    print_success "Removed installation: ~/.snapback"
  fi

  # Remove menu-bar app
  for app_dir in "$HOME/Applications/SnapBack.app" "/Applications/SnapBack.app"; do
    if [[ -d "$app_dir" ]]; then
      rm -rf "$app_dir"
      print_success "Removed $app_dir"
    fi
  done

  echo ""
  print_success "SnapBack uninstalled"
  echo ""
}

# ============================================================
# UPDATE COMMAND
# ============================================================
cmd_update() {
  echo ""
  echo "SnapBack Update"
  echo "───────────────"
  echo ""

  local repo_url="https://github.com/teoobarca/snapback"

  # Resolve actual install directory (follow symlinks)
  local install_dir="$SCRIPT_DIR"
  if [[ -L "$0" ]]; then
    # We're running from a symlink, find the real location
    local real_path=$(readlink "$0" 2>/dev/null || true)
    if [[ -n "$real_path" ]]; then
      install_dir="$(cd "$(dirname "$real_path")" && pwd)"
    fi
  fi

  # Check if we're in a git repo
  if [[ -d "$install_dir/.git" ]]; then
    print_info "Updating via git..."
    cd "$install_dir"
    if git pull origin main 2>/dev/null; then
      print_success "Updated to latest version"
    else
      print_error "Git pull failed"
      print_info "Try: cd $install_dir && git pull"
      exit 1
    fi
  else
    print_info "Updating via tarball..."
    local tmp_dir=$(mktemp -d)
    if curl -sL "$repo_url/archive/main.tar.gz" | tar xz -C "$tmp_dir" --strip-components=1; then
      # Copy new files to install directory
      cp "$tmp_dir/snapback" "$install_dir/"
      cp "$tmp_dir/snapback.sh" "$install_dir/"
      cp "$tmp_dir/snapback-resume.sh" "$install_dir/"
      cp "$tmp_dir/snapback-lib.sh" "$install_dir/"
      cp "$tmp_dir/install.sh" "$install_dir/"
      cp "$tmp_dir/notification.mp3" "$install_dir/" 2>/dev/null || true
      # Per-tool integration folders (claude/, codex/, …)
      for d in "$tmp_dir"/*/; do
        name="$(basename "$d")"
        # Only copy folders that look like tool integrations.
        [[ -f "$d/detect.sh" && -f "$d/enable.sh" ]] || continue
        rm -rf "$install_dir/$name"
        cp -R "$d" "$install_dir/"
        chmod +x "$install_dir/$name"/*.sh 2>/dev/null || true
      done
      rm -rf "$install_dir/SnapBackApp"
      cp -R "$tmp_dir/SnapBackApp" "$install_dir/"
      chmod +x "$install_dir/snapback" "$install_dir/snapback.sh" \
               "$install_dir/snapback-resume.sh" "$install_dir/install.sh" \
               "$install_dir/SnapBackApp/build-app.sh"
      rm -rf "$tmp_dir"
      print_success "Updated to latest version"
    else
      rm -rf "$tmp_dir"
      print_error "Download failed"
      exit 1
    fi
  fi

  # Menu-bar app maintenance — install to ~/Applications (no sudo)
  local app_dir="$HOME/Applications"
  local app_installed=""
  for p in "$app_dir/SnapBack.app" "/Applications/SnapBack.app"; do
    if [[ -d "$p" ]]; then app_installed="$p"; break; fi
  done

  if [[ -d "$install_dir/SnapBackApp" ]] && command -v swift &>/dev/null; then
    print_info "Rebuilding menu-bar app..."
    (
      cd "$install_dir/SnapBackApp"
      export SNAPBACK_CLI_PATH="$HOME/.local/bin/snapback"
      ./build-app.sh
    )
    # Always install to ~/Applications (no sudo needed)
    mkdir -p "$app_dir"
    rm -rf "$app_dir/SnapBack.app"
    cp -R "$install_dir/SnapBackApp/SnapBack.app" "$app_dir/"
    # Clean up legacy /Applications copy if we now have ~/Applications
    if [[ -d "/Applications/SnapBack.app" ]] && [[ -w "/Applications/SnapBack.app" ]]; then
      rm -rf "/Applications/SnapBack.app"
    fi
    print_success "Menu-bar app rebuilt at ~/Applications/SnapBack.app"
  elif [[ -d "$install_dir/SnapBackApp" ]]; then
    print_info "Menu-bar app present but Swift not available — install Xcode Command Line Tools to build."
  fi

  echo ""
  # Show new version
  "$install_dir/snapback" --version
  echo ""
}

# ============================================================
# APP COMMAND (Menu Bar App)
# ============================================================
cmd_app() {
  local app_bundle="$SCRIPT_DIR/SnapBackApp/SnapBack.app"

  # Check if app exists — prefer ~/Applications, then /Applications, then dev build
  for p in "$HOME/Applications/SnapBack.app" "/Applications/SnapBack.app" "$app_bundle"; do
    if [[ -d "$p" ]]; then
      open "$p"
      return
    fi
  done

  print_error "SnapBack menu bar app not found"
  print_info "Build it first: cd $SCRIPT_DIR/SnapBackApp && ./build-app.sh"
  exit 1
}

# ============================================================
# VOLUME COMMAND
# ============================================================
cmd_volume() {
  local v="${1:-}"
  if [[ -z "$v" ]]; then
    config_get VOLUME || echo "1.0"
    exit 0
  fi
  # Validate 0.0 <= v <= 1.0
  if ! [[ "$v" =~ ^(0(\.[0-9]+)?|1(\.0+)?)$ ]]; then
    print_error "Invalid volume: $v (expected 0.0 - 1.0)"
    exit 2
  fi
  config_set VOLUME "$v" --allow-new
  print_success "Volume set to: $v"
}

# ============================================================
# BROWSER COMMAND
# ============================================================
cmd_browser() {
  local b="${1:-}"
  if [[ -z "$b" ]]; then
    config_get BROWSER || echo "Google Chrome"
    exit 0
  fi
  config_set BROWSER "$b"
  print_success "Browser set to: $b"
}

# ============================================================
# FOCUS COMMAND
# ============================================================
_focus_escape_token() {
  local v="$1"
  v="${v//\\/\\\\}"
  v="${v//\$/\\\$}"
  v="${v//\`/\\\`}"
  v="${v//\"/\\\"}"
  printf '"%s"' "$v"
}

_focus_write_array() {
  local literal='('
  local a
  for a in "$@"; do
    literal+="$(_focus_escape_token "$a") "
  done
  literal="${literal% })"
  config_set FOCUS_APPS "$literal"
}

cmd_focus() {
  local sub="${1:-list}"
  shift || true
  # Snapshot current list (bash 3.2-compatible — no mapfile)
  local apps=()
  if [[ -f "$CONFIG_FILE" ]]; then
    while IFS= read -r line; do
      apps+=("$line")
    done < <(
      # shellcheck disable=SC1090
      source "$CONFIG_FILE" 2>/dev/null
      for a in "${FOCUS_APPS[@]+"${FOCUS_APPS[@]}"}"; do printf '%s\n' "$a"; done
    )
  fi
  case "$sub" in
    list)
      local a
      for a in "${apps[@]+"${apps[@]}"}"; do printf '%s\n' "$a"; done
      ;;
    add)
      [[ $# -ge 1 ]] || { print_error "Usage: snapback focus add NAME"; exit 2; }
      local new="$1"
      local a
      for a in "${apps[@]+"${apps[@]}"}"; do
        [[ "$a" == "$new" ]] && { print_info "Already present: $new"; exit 0; }
      done
      apps+=("$new")
      _focus_write_array "${apps[@]+"${apps[@]}"}"
      print_success "Added: $new"
      ;;
    remove)
      [[ $# -ge 1 ]] || { print_error "Usage: snapback focus remove NAME"; exit 2; }
      local drop="$1" kept=() changed=0
      local a
      for a in "${apps[@]+"${apps[@]}"}"; do
        if [[ "$a" == "$drop" ]]; then changed=1; else kept+=("$a"); fi
      done
      if (( changed == 0 )); then
        print_warning "Not present: $drop"
        exit 0
      fi
      if (( ${#kept[@]} == 0 )); then
        print_error "Cannot remove last focus app (list would be empty)"
        print_info "Use 'snapback focus set NAME1 NAME2 ...' to replace the whole list"
        exit 1
      fi
      _focus_write_array "${kept[@]+"${kept[@]}"}"
      print_success "Removed: $drop"
      ;;
    set)
      [[ $# -ge 1 ]] || { print_error "Usage: snapback focus set NAME [NAME ...]"; exit 2; }
      _focus_write_array "$@"
      print_success "Focus apps set to: $*"
      ;;
    *)
      print_error "Unknown focus subcommand: $sub"
      exit 2
      ;;
  esac
}

# ============================================================
# CONFIG COMMAND
# ============================================================
cmd_config() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    get)
      [[ $# -ge 1 ]] || { print_error "Usage: snapback config get KEY"; exit 2; }
      config_get "$1" || { print_error "Key not set: $1"; exit 1; }
      ;;
    set)
      [[ $# -ge 2 ]] || { print_error "Usage: snapback config set KEY VALUE [--allow-new]"; exit 2; }
      config_set "$@" || exit $?
      ;;
    show)
      local json=0
      [[ "${1:-}" == "--json" ]] && json=1
      if (( json )); then
        local first=1
        echo "{"
        while read -r k ktype; do
          local v
          if v=$(config_get "$k" 2>/dev/null); then
            (( first )) || echo ","
            first=0
            if [[ "$ktype" == "array" ]]; then
              # Emit as JSON array; config_get returns one token per line.
              printf '  "%s": [' "$k"
              local first_item=1
              while IFS= read -r item; do
                [[ -z "$item" ]] && continue
                (( first_item )) || printf ', '
                first_item=0
                local esc="${item//\\/\\\\}"
                esc="${esc//\"/\\\"}"
                printf '"%s"' "$esc"
              done <<< "$v"
              printf ']'
            else
              # Shell-escape for JSON: minimal (no \n in values)
              local esc="${v//\\/\\\\}"
              esc="${esc//\"/\\\"}"
              printf '  "%s": "%s"' "$k" "$esc"
            fi
          fi
        done < <(_snapback_known_keys)
        echo ""
        echo "}"
      else
        while read -r k _; do
          local v
          if v=$(config_get "$k" 2>/dev/null); then
            printf '%s=%s\n' "$k" "$v"
          fi
        done < <(_snapback_known_keys)
      fi
      ;;
    path)
      printf '%s\n' "$CONFIG_FILE"
      ;;
    "")
      print_error "Usage: snapback config <get|set|show|path> ..."
      exit 2
      ;;
    *)
      print_error "Unknown config subcommand: $sub"
      exit 2
      ;;
  esac
}

# ============================================================
# TEST COMMAND
# ============================================================
cmd_test() {
  [[ -f "$CONFIG_FILE" ]] || { print_error "Config not found"; exit 1; }
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  # Resolve "default"
  if [[ "${NOTIFICATION_SOUND:-}" == "default" ]]; then
    NOTIFICATION_SOUND="$SCRIPT_DIR/notification.mp3"
  fi
  if [[ -z "${NOTIFICATION_SOUND:-}" ]]; then
    print_info "NOTIFICATION_SOUND is empty — no sound to play."
    exit 0
  fi
  if [[ ! -f "$NOTIFICATION_SOUND" ]]; then
    print_error "Sound file not found: $NOTIFICATION_SOUND"
    exit 1
  fi
  local sysVol effectiveVol
  sysVol=$(osascript -e "output volume of (get volume settings)" 2>/dev/null || echo 100)
  effectiveVol=$(echo "${VOLUME:-1.0} * $sysVol / 100" | bc -l 2>/dev/null || echo "${VOLUME:-1.0}")
  afplay -v "$effectiveVol" "$NOTIFICATION_SOUND"
  print_success "Played $NOTIFICATION_SOUND at ${effectiveVol}"
}

# ============================================================
# INSTALL COMMAND
# ============================================================
cmd_install() {
  # Just run the existing install script, passing through arguments
  if [[ -x "$SCRIPT_DIR/install.sh" ]]; then
    exec "$SCRIPT_DIR/install.sh" "$@"
  else
    print_error "install.sh not found in $SCRIPT_DIR"
    exit 1
  fi
}

# ============================================================
# MOBILE COMMAND (1.3.0 bridge)
# ============================================================
cmd_mobile() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    enable)
      config_set MOBILE_ENABLED true
      print_success "MOBILE_ENABLED=true"
      ;;
    disable)
      config_set MOBILE_ENABLED false
      print_success "MOBILE_ENABLED=false"
      ;;
    status)
      local enabled
      enabled=$(config_get MOBILE_ENABLED 2>/dev/null || echo "false")
      echo ""
      echo "Mobile bridge"
      echo "─────────────"
      echo "  enabled: $enabled"
      echo "  socket:  ${SNAPBACK_BRIDGE_SOCKET:-unset}"
      if [[ -S "${SNAPBACK_BRIDGE_SOCKET:-}" ]]; then
        print_success "bridge socket is live"
      else
        print_warning "bridge socket not present (menu-bar app running?)"
      fi
      local dname
      dname=$(config_get MOBILE_DEVICE_NAME 2>/dev/null || echo "")
      if [[ -n "$dname" ]]; then
        print_info "  paired peer: $dname"
      else
        print_info "  no paired peer"
      fi
      echo ""
      ;;
    pair)
      cmd_app
      print_info "Opened SnapBackApp; use 'Pair mobile…' in the menu-bar popover."
      ;;
    unpair)
      if command -v security >/dev/null 2>&1; then
        security delete-generic-password -s com.snapback.mobile -a pair-token >/dev/null 2>&1 || true
      fi
      config_set MOBILE_DEVICE_NAME "" || true
      config_set MOBILE_ENABLED false || true
      print_success "Unpaired (Keychain token cleared)."
      ;;
    logs)
      local log="$HOME/Library/Logs/SnapBack/bridge.log"
      if [[ -f "$log" ]]; then
        tail -n 200 "$log"
      else
        print_warning "no log file yet: $log"
      fi
      ;;
    "")
      print_error "Usage: snapback mobile <pair|unpair|status|enable|disable|logs>"
      exit 2
      ;;
    *)
      print_error "Unknown mobile subcommand: $sub"
      exit 2
      ;;
  esac
}

# ============================================================
# MAIN
# ============================================================
main() {
  local cmd="${1:-help}"
  shift || true  # Remove first argument, keep the rest for passing to commands

  case "$cmd" in
    install)
      cmd_install "$@"
      ;;
    status)
      cmd_status
      ;;
    on|enable)
      cmd_on
      ;;
    off|disable)
      cmd_off
      ;;
    mode)
      cmd_mode "$@"
      ;;
    volume)
      cmd_volume "$@"
      ;;
    browser)
      cmd_browser "$@"
      ;;
    focus)
      cmd_focus "$@"
      ;;
    config)
      cmd_config "$@"
      ;;
    test)
      cmd_test
      ;;
    app)
      cmd_app
      ;;
    mobile)
      cmd_mobile "$@"
      ;;
    update)
      cmd_update
      ;;
    uninstall|remove)
      cmd_uninstall
      ;;
    -h|--help|help)
      show_help
      ;;
    -v|--version|version)
      echo "SnapBack v${VERSION}"
      ;;
    *)
      print_error "Unknown command: $cmd"
      echo ""
      show_help
      exit 1
      ;;
  esac
}

main "$@"
